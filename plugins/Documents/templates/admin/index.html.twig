{% extends 'admin/layout.html.twig' %}
{% block content %}<div class="page-head"><div><span class="eyebrow blue">COMPANYWARE</span><h1>Dokumentenmanagement</h1><p>Zentrale Grundlage für Dokumente in Firmen-, Vereins- und kommunalen Prozessen.</p></div></div>{% if error %}<div class="alert error">{{ error }}</div>{% endif %}<section class="panel document-upload"><div><h2>Dokument ablegen</h2><p>PDF, Word, Text oder Bild bis 15 MB.</p></div><form method="post" enctype="multipart/form-data"><input type="hidden" name="_token" value="{{ token }}"><input name="title" placeholder="Titel oder Vorgang"><input type="file" name="document" required><button class="primary">Hochladen</button></form></section><section class="panel"><div class="panel-head"><div><h2>Dokumente</h2><p>{{ documents|length }} Einträge im sicheren Dateispeicher.</p></div></div><div class="document-list">{% for document in documents %}<article><div class="plugin-symbol">D</div><div><strong>{{ document.title }}</strong><small>{{ document.original_name }} · {{ (document.file_size / 1024)|round }} KB · {{ document.created_at }}</small></div><a class="secondary" href="{{ path('documents_download',{id:document.id}) }}">Download</a><form method="post" action="{{ path('documents_delete',{id:document.id}) }}" onsubmit="return confirm('Dokument löschen?')"><input type="hidden" name="_token" value="{{ token }}"><button class="danger">Löschen</button></form></article>{% else %}<div class="empty-state">Noch keine Dokumente vorhanden.</div>{% endfor %}</div></section>{% endblock %}
