{% extends 'admin/layout.html.twig' %}
{% block content %}<div class="page-head"><div><span class="eyebrow blue">{{ 'documents.eyebrow'|trans }}</span><h1>{{ 'documents.title'|trans }}</h1><p>{{ 'documents.intro'|trans }}</p></div></div>{% if error %}<div class="alert error">{{ error }}</div>{% endif %}<section class="panel document-upload" id="document-upload"><div><h2>{{ 'documents.upload_title'|trans }}</h2><p>{{ 'documents.upload_hint'|trans({'%size%':maxUploadMb}) }}</p></div><form method="post" enctype="multipart/form-data"><input type="hidden" name="_token" value="{{ token }}"><input name="title" placeholder="{{ 'documents.title_placeholder'|trans }}"><input type="file" name="document" required><button class="primary">{{ 'documents.upload'|trans }}</button></form></section><section class="panel"><div class="panel-head"><div><h2>{{ 'documents.list_title'|trans }}</h2><p>{{ 'documents.count'|trans({'%count%': documents|length}) }}</p></div></div><div class="document-list">{% for document in documents %}<article><div class="plugin-symbol">D</div><div><strong>{{ document.title }}</strong><small>{{ document.original_name }} · {{ (document.file_size / 1024)|round }} KB · {{ document.created_at }}</small></div><a class="secondary" href="{{ path('documents_download',{id:document.id}) }}">{{ 'documents.download'|trans }}</a><form method="post" action="{{ path('documents_delete',{id:document.id}) }}" onsubmit="return confirm('{{ 'documents.delete_confirm'|trans|e('js') }}')"><input type="hidden" name="_token" value="{{ token }}"><button class="danger">{{ 'documents.delete'|trans }}</button></form></article>{% else %}<div class="empty-state">{{ 'documents.empty'|trans }}</div>{% endfor %}</div></section>{% endblock %}
