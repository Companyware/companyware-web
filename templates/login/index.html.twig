{% extends 'base.html.twig' %}

{% block title %}Anmelden · Companyware{% endblock %}
{% block body_class %}login-body{% endblock %}

{% block body %}
<main class="login-shell">
    {% block login_visual %}
    <section class="login-visual">
        <img src="/assets/brand/companyware-login-hero-cool.png?v=20260817" alt="Abstrakte, miteinander verbundene Prozessmodule">
        <div class="login-visual-shade"></div>
        <div class="visual-copy">
            <span class="eyebrow">Companyware · Open process platform</span>
            <h2>Aus Bausteinen<br>wird Fortschritt.</h2>
            <p>Companyware verbindet Menschen, Informationen und Abläufe zu genau der Lösung, die deine Organisation braucht.</p>
        </div>
    </section>
    {% endblock %}

    <section class="login-panel">
        <div class="login-panel-inner">
            <a class="brand-lockup brand-lockup-dark" href="{{ path('app_login') }}" aria-label="Companyware">
                <img src="/assets/brand/companyware-mark.svg?v=20260817" alt="">
                <span>Companyware</span>
            </a>

            <div class="login-form-wrap">
                {{ plugin_slot('login.form.before') }}
                <span class="eyebrow">Willkommen zurück</span>
                <h1>Dein Arbeitsraum<br>für gute Prozesse.</h1>
                <p class="muted">Melde dich an und bringe die Dinge ins Rollen.</p>

                {% if error %}<div class="alert error">{{ error }}</div>{% endif %}

                {% block login_form %}
                <form method="post">
                    <input type="hidden" name="_token" value="{{ token }}">
                    <label>Benutzername
                        <input name="username" autocomplete="username" required autofocus placeholder="Dein Benutzername">
                    </label>
                    <label>Passwort
                        <span class="password-wrap">
                            <input id="password" type="password" name="password" autocomplete="current-password" required placeholder="Dein Passwort">
                            <button type="button" class="show-password" data-password-toggle="password">Anzeigen</button>
                        </span>
                    </label>
                    <div class="login-options">
                        <label class="check"><input type="checkbox" name="remember"> <span>Angemeldet bleiben</span></label>
                        <span>Sicherer Zugang</span>
                    </div>
                    <button class="primary wide" type="submit">Arbeitsraum öffnen <span>↗</span></button>
                </form>
                {% endblock %}

                <p class="login-help">Probleme bei der Anmeldung? Wende dich an deine Administration.</p>
                {{ plugin_slot('login.form.after') }}
            </div>

            <small class="login-footer">Open Source. Erweiterbar. Für deine Organisation.</small>
        </div>
    </section>
</main>
{% endblock %}
