{% extends 'base.html.twig' %}{% block title %}Anmelden · Administration{% endblock %}{% block body_class %}login-body{% endblock %}{% block body %}<main class="login-card">{% block login_visual %}<section class="login-visual"><div class="brand-mark">A</div><div class="visual-copy"><span class="eyebrow">ADMIN FRAMEWORK</span><h1>Willkommen<br>zurück.</h1><p>Eine modulare Oberfläche für deine Werkzeuge, Prozesse und Plugins.</p></div><div class="visual-grid"></div></section>{% endblock %}<section class="login-panel"><div class="login-form-wrap">{{ plugin_slot('login.form.before') }}<span class="eyebrow blue">SICHERER ZUGANG</span><h2>In der Administration anmelden</h2><p class="muted">Gib deine Zugangsdaten ein, um fortzufahren.</p>{% if error %}<div class="alert error">{{ error }}</div>{% endif %}{% block login_form %}<form method="post"><input type="hidden" name="_token" value="{{ token }}"><label>Benutzername<input name="username" autocomplete="username" required autofocus placeholder="Dein Benutzername"></label><label>Passwort<span class="password-wrap"><input id="password" type="password" name="password" autocomplete="current-password" required placeholder="Dein Passwort"><button type="button" class="show-password" data-password-toggle="password">Anzeigen</button></span></label><label class="check"><input type="checkbox" name="remember"> <span>Angemeldet bleiben</span></label><button class="primary wide" type="submit">Anmelden <span>→</span></button></form>{% endblock %}<p class="login-help">Probleme bei der Anmeldung? Wende dich an deine Administration.</p>{{ plugin_slot('login.form.after') }}</div></section></main>{% endblock %}
