{% extends 'base.html.twig' %}

{% block title %}{{ 'login.title'|trans }} · Companyware{% endblock %}
{% block body_class %}login-body{% endblock %}

{% block body %}
<main class="login-shell">
    {% block login_visual %}
    <section class="login-visual">
        <img src="/assets/brand/companyware-login-hero-cool.png?v=20260817" alt="{{ 'login.visual_alt'|trans }}">
        <div class="login-visual-shade"></div>
        <div class="visual-copy">
            <span class="eyebrow">Companyware · Open process platform</span>
            <h2>{{ 'login.visual_title'|trans|raw }}</h2>
            <p>{{ 'login.visual_text'|trans }}</p>
        </div>
    </section>
    {% endblock %}

    <section class="login-panel">
        <div class="login-panel-inner">
            <a class="brand-lockup brand-lockup-dark" href="{{ path('app_login') }}" aria-label="Companyware">
                <img src="/assets/brand/companyware-mark.svg?v=20260817" alt="">
                <span>Companyware</span>
            </a>

            <div class="login-form-wrap">
                {{ plugin_slot('login.form.before') }}
                <span class="eyebrow">{{ 'login.welcome'|trans }}</span>
                <h1>{{ 'login.headline'|trans|raw }}</h1>
                <p class="muted">{{ 'login.intro'|trans }}</p>

                {% if error %}<div class="alert error">{{ error }}</div>{% endif %}

                {% block login_form %}
                <form method="post">
                    <input type="hidden" name="_token" value="{{ token }}">
                    <label>{{ 'login.username'|trans }}
                        <input name="username" autocomplete="username" required autofocus placeholder="{{ 'login.username_placeholder'|trans }}">
                    </label>
                    <label>{{ 'login.password'|trans }}
                        <span class="password-wrap">
                            <input id="password" type="password" name="password" autocomplete="current-password" required placeholder="{{ 'login.password_placeholder'|trans }}">
                            <button type="button" class="show-password" data-password-toggle="password">{{ 'login.show_password'|trans }}</button>
                        </span>
                    </label>
                    <div class="login-options">
                        <label class="check"><input type="checkbox" name="remember"> <span>{{ 'login.remember'|trans }}</span></label>
                        <span>{{ 'login.secure'|trans }}</span>
                    </div>
                    <button class="primary wide" type="submit">{{ 'login.submit'|trans }} <span>↗</span></button>
                </form>
                {% endblock %}

                <p class="login-help">{{ 'login.help'|trans }}</p>
                {{ plugin_slot('login.form.after') }}
            </div>

            <small class="login-footer">{{ 'login.footer'|trans }}</small>
        </div>
    </section>
</main>
{% endblock %}
