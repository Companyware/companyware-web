{% extends 'base.html.twig' %}{% block title %}{{ 'recovery.title'|trans }} · {{ 'layout.product_name'|trans }}{% endblock %}{% block body_class %}login-body recovery-body{% endblock %}{% block body %}<main class="login-shell"><section class="login-visual"><img src="/assets/brand/companyware-login-hero-cool.png?v=20260817" alt="{{ 'login.visual_alt'|trans }}"><div class="login-visual-shade"></div><div class="login-visual-copy"><span class="eyebrow">{{ 'layout.product_name'|trans|upper }} · OPEN PROCESS PLATFORM</span><h2>{{ 'login.visual_title'|trans|raw }}</h2><p>{{ 'login.visual_text'|trans }}</p></div></section><section class="login-panel"><div class="login-panel-inner"><a class="brand-lockup brand-lockup-dark" href="{{ path('app_login') }}" aria-label="{{ 'layout.product_name'|trans }}"><span class="brand-mark"><span></span></span><span class="brand-product"><strong>Companyware</strong><span class="brand-product-suffix">Web</span></span></a><div class="login-form-wrap"><span class="eyebrow">{{ 'recovery.eyebrow'|trans }}</span><h1>{{ 'recovery.headline'|trans }}</h1><p class="muted">{{ 'recovery.intro'|trans }}</p>{% if mailRequested %}<div class="alert success">{{ 'recovery.mail_neutral'|trans }}</div>{% endif %}<form method="post"><input type="hidden" name="_token" value="{{ token }}"><input type="hidden" name="action" value="request_email"><label>{{ 'recovery.email'|trans }}<input type="email" name="email" autocomplete="email" required></label><button class="secondary wide" type="submit">{{ 'recovery.email_submit'|trans }}</button></form>{% if completed %}<div class="alert success">{{ 'recovery.success'|trans({'%username%': completed.username}) }}</div><a class="primary wide recovery-login-link" href="{{ path('app_login') }}">{{ 'recovery.login'|trans }}</a>{% else %}{% if submitted %}<div class="alert error">{{ 'recovery.neutral_error'|trans }}</div>{% endif %}<form method="post"><input type="hidden" name="_token" value="{{ token }}"><label>{{ 'recovery.key'|trans }}<input name="recovery_key" value="{{ recoveryKey }}" autocomplete="off" required></label><label>{{ 'recovery.new_password'|trans({'%minimum%': minimumPasswordLength}) }}<input type="password" name="password" minlength="{{ minimumPasswordLength }}" autocomplete="new-password" required></label><label>{{ 'recovery.confirm_password'|trans }}<input type="password" name="password_confirmation" minlength="{{ minimumPasswordLength }}" autocomplete="new-password" required></label><button class="primary wide" type="submit">{{ 'recovery.submit'|trans }}</button></form><p class="login-help">{{ 'recovery.admin_hint'|trans }}</p>{% endif %}</div><small class="login-footer"><a href="{{ path('app_login') }}">{{ 'recovery.back'|trans }}</a></small></div></section></main>{% endblock %}
