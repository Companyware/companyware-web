<!doctype html><html lang="de"><head>{% block head %}<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>{% block title %}Administration{% endblock %}</title>{% block stylesheets %}{% for asset in admin_stylesheets() %}<link rel="stylesheet" href="{{ asset.url }}" data-asset-handle="{{ asset.handle }}">{% endfor %}{{ plugin_slot('document.stylesheets') }}{% endblock %}{% endblock %}</head><body class="{% block body_class %}{% endblock %}">{% block body %}{% endblock %}{% block javascripts %}{% for asset in admin_javascripts() %}<script src="{{ asset.url }}" data-asset-handle="{{ asset.handle }}"{% if asset.defer|default(true) %} defer{% endif %}></script>{% endfor %}{{ plugin_slot('document.javascripts') }}{% endblock %}</body></html>
