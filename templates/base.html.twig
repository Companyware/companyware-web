<!doctype html><html lang="{{ app.request.locale }}" data-theme="{{ active_theme().id }}" data-color-scheme="{{ color_scheme() }}"><head>{% block head %}<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="theme-color" content="#f5f6fb"><meta name="application-name" content="{{ 'layout.product_name'|trans }}"><meta name="description" content="{{ 'layout.meta_description'|trans }}"><meta property="og:site_name" content="{{ 'layout.product_name'|trans }}"><title>{% block title %}{{ 'layout.product_name'|trans }}{% endblock %}</title><link rel="icon" href="/assets/brand/companyware-mark.svg?v=20260817" type="image/svg+xml">{% block stylesheets %}{% for asset in admin_stylesheets() %}<link rel="stylesheet" href="{{ asset.url }}" data-asset-handle="{{ asset.handle }}">{% endfor %}{% block theme_stylesheets %}{% for stylesheet in theme_stylesheets() %}<link rel="stylesheet" href="{{ stylesheet }}" data-theme-stylesheet>{% endfor %}{% endblock %}{{ plugin_slot('document.stylesheets') }}{% endblock %}{% endblock %}</head><body class="{% block body_class %}{% endblock %}">{{ plugin_slot('document.body.before') }}{% block body %}{% endblock %}{{ plugin_slot('document.body.after') }}{% block javascripts %}{% for asset in admin_javascripts() %}<script src="{{ asset.url }}" data-asset-handle="{{ asset.handle }}"{% if asset.defer|default(true) %} defer{% endif %}></script>{% endfor %}{{ plugin_slot('document.javascripts') }}{% endblock %}</body></html>
