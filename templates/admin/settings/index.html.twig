{% extends 'admin/layout.html.twig' %}{% block content %}<div class="page-head"><div><span class="eyebrow blue">{{ 'settings.eyebrow'|trans }}</span><h1>{{ 'settings.title'|trans }}</h1><p>{{ 'settings.intro'|trans }}</p></div></div>{% if saved %}<div class="alert success">{{ 'settings.saved'|trans }}</div>{% endif %}<section class="panel form-panel"><div class="panel-head"><div><h2>{{ 'settings.general'|trans }}</h2><p>{{ 'settings.plugins_hint'|trans }}</p></div></div><form method="post" class="admin-form"><input type="hidden" name="_token" value="{{ token }}"><label>{{ 'settings.app_name'|trans }}<input name="app_name" value="{{ appName }}" required></label><label>{{ 'settings.language'|trans }}<select name="locale">{% for code,label in locales %}<option value="{{ code }}" {{ code == currentLocale ? 'selected' : '' }}>{{ label }}</option>{% endfor %}</select></label>{{ plugin_slot('admin.settings.fields') }}<div class="form-actions"><button class="primary">{{ 'settings.save'|trans }}</button></div></form></section>{{ plugin_slot('admin.settings.sections') }}{% endblock %}
