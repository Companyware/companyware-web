{% extends 'admin/layout.html.twig' %}{% block content %}<div class="page-head"><div><span class="eyebrow blue">{{ 'settings.eyebrow'|trans }}</span><h1>{{ 'settings.title'|trans }}</h1><p>{{ 'settings.intro'|trans }}</p></div></div>{% if saved %}<div class="alert success">{{ 'settings.saved'|trans }}</div>{% endif %}<section class="panel form-panel"><div class="panel-head"><div><h2>{{ 'settings.general'|trans }}</h2><p>{{ 'settings.plugins_hint'|trans }}</p></div></div><form method="post" class="admin-form"><input type="hidden" name="_token" value="{{ token }}"><label>{{ 'settings.app_name'|trans }}<input name="app_name" value="{{ appName }}" required></label><label>{{ 'settings.language'|trans }}<select name="locale">{% for code,label in locales %}<option value="{{ code }}" {{ code == currentLocale ? 'selected' : '' }}>{{ label }}</option>{% endfor %}</select></label><label>{{ 'settings.theme'|trans }}<select name="theme">{% for theme in themes %}<option value="{{ theme.id }}" {{ theme.id == currentTheme.id ? 'selected' : '' }}>{{ theme.label|trans }}</option>{% endfor %}</select><small>{{ 'settings.theme_hint'|trans }}</small></label>{% if currentTheme.settings|length %}<div class="theme-edit-action"><button type="button" class="secondary" onclick="document.getElementById('theme-settings-dialog').showModal()">{{ 'theme.edit'|trans }}</button></div>{% endif %}{{ plugin_slot('admin.settings.fields') }}<div class="form-actions"><button class="primary">{{ 'settings.save'|trans }}</button></div></form>{% if currentTheme.settings|length %}<dialog id="theme-settings-dialog" class="theme-settings-dialog"><form method="post" class="admin-form"><input type="hidden" name="_token" value="{{ token }}"><input type="hidden" name="action" value="theme_settings"><div class="dialog-head"><div><h2>{{ 'theme.edit_title'|trans({'%theme%':currentTheme.label|trans}) }}</h2><p>{{ 'theme.edit_hint'|trans }}</p></div><button type="button" class="icon-action" onclick="this.closest('dialog').close()" aria-label="{{ 'common.close'|trans }}">×</button></div>{% for field in currentTheme.settings %}<label>{{ field.label|trans }}{% if field.type == 'select' %}<select name="theme_settings[{{ field.key }}]">{% for option in field.options %}<option value="{{ option.value }}" {{ themeValues[field.key]|default(field.default|default(null)) == option.value ? 'selected' : '' }}>{{ option.label|trans }}</option>{% endfor %}</select>{% elseif field.type == 'checkbox' %}<input type="checkbox" name="theme_settings[{{ field.key }}]" value="1" {{ themeValues[field.key]|default(field.default|default(false)) ? 'checked' : '' }}>{% else %}<input type="{{ field.type == 'number' ? 'number' : 'text' }}" name="theme_settings[{{ field.key }}]" value="{{ themeValues[field.key]|default(field.default|default('')) }}"{% if field.min is defined %} min="{{ field.min }}"{% endif %}{% if field.max is defined %} max="{{ field.max }}"{% endif %}>{% endif %}{% if field.help is defined %}<small>{{ field.help|trans }}</small>{% endif %}</label>{% endfor %}<div class="form-actions"><button type="button" class="secondary" onclick="this.closest('dialog').close()">{{ 'common.close'|trans }}</button><button class="primary">{{ 'theme.save'|trans }}</button></div></form></dialog>{% endif %}</section>{{ plugin_slot('admin.settings.sections') }}{% endblock %}
