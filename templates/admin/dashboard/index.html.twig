{% extends 'admin/layout.html.twig' %}

{% block content %}
{% block dashboard_header %}
<div class="dashboard-welcome">
    <div>
        <span class="eyebrow blue">{{ 'dashboard.eyebrow'|trans }}</span>
        <h1>{{ 'dashboard.welcome'|trans({'%name%': admin.display_name}) }}</h1>
        <p>{{ 'dashboard.intro'|trans }}</p>
    </div>
    <div class="dashboard-mark" aria-hidden="true"><img src="/assets/brand/companyware-mark.svg?v=20260817" alt=""></div>
</div>
{% endblock %}

{{ plugin_slot('dashboard.content.before', {admin: admin, plugins: plugins}) }}

{% block dashboard_quick_actions %}
<section class="dashboard-section">
    <div class="dashboard-section-head"><h2>{{ 'dashboard.quick_actions'|trans }}</h2></div>
    <div class="quick-actions">
        <a class="quick-action" href="{{ path('admin_plugins') }}"><span class="nav-icon">◇</span><span>{{ 'nav.plugins'|trans }}</span><b>→</b></a>
        <a class="quick-action" href="{{ path('admin_settings') }}"><span class="nav-icon">⚙</span><span>{{ 'nav.settings'|trans }}</span><b>→</b></a>
        {{ plugin_slot('dashboard.quick_actions', {admin: admin, plugins: plugins}) }}
    </div>
</section>
{% endblock %}

{% block dashboard_widgets %}
<section class="dashboard-section">
    <div class="dashboard-section-head"><h2>{{ 'dashboard.overview'|trans }}</h2><p>{{ 'dashboard.overview_hint'|trans }}</p></div>
    <div class="dashboard-grid">
        <article class="panel dashboard-widget dashboard-system-widget">
            <div class="dashboard-widget-head"><span class="widget-icon">✓</span><div><h3>{{ 'dashboard.system_status'|trans }}</h3><p>{{ 'layout.ready'|trans }}</p></div></div>
            <div class="dashboard-metrics">
                <div><strong>{{ activePluginCount }}</strong><span>{{ 'dashboard.active_plugins'|trans }}</span></div>
                <div><strong>{{ plugins|length }}</strong><span>{{ 'dashboard.installed_plugins'|trans }}</span></div>
                <div><strong>0</strong><span>{{ 'plugins.updates'|trans }}</span></div>
            </div>
        </article>
        {{ plugin_slot('dashboard.widgets', {admin: admin, plugins: plugins}) }}
    </div>
</section>
{% endblock %}

{{ plugin_slot('dashboard.content.after', {admin: admin, plugins: plugins}) }}
{% endblock %}
