{% extends 'admin/layout.html.twig' %}

{% block content %}
{% set continue_items %}{{ plugin_slot('dashboard.continue', {admin: admin, plugins: plugins}) }}{% endset %}
{% set activity_items %}{{ plugin_slot('dashboard.activity', {admin: admin, plugins: plugins}) }}{% endset %}
<div class="dashboard" data-dashboard data-dashboard-owner="{{ admin.id }}" data-dashboard-save-url="{{ path('admin_dashboard_layout') }}" data-dashboard-token="{{ token }}" data-label-drag="{{ 'dashboard.drag_widget'|trans }}" data-label-hide="{{ 'dashboard.hide_widget'|trans }}" data-label-restore="{{ 'dashboard.restore_widget'|trans }}">
    <script type="application/json" data-dashboard-state>{{ dashboardState|json_encode|raw }}</script>
    {% block dashboard_header %}
    <div class="dashboard-welcome">
        <div>
            <span class="eyebrow blue">{{ 'dashboard.eyebrow'|trans }}</span>
            <h1>{{ 'dashboard.welcome'|trans({'%name%': admin.display_name}) }}</h1>
            <p>{{ 'dashboard.intro'|trans }}</p>
        </div>
        <div class="dashboard-header-actions">
            <button class="secondary dashboard-customize" type="button" data-dashboard-customize>{{ 'dashboard.customize'|trans }}</button>
            <button class="secondary dashboard-add" type="button" data-dashboard-add hidden aria-expanded="false" aria-label="{{ 'dashboard.add_widgets'|trans }}">+ {{ 'dashboard.add_widgets'|trans }}</button>
            <button class="secondary dashboard-reset" type="button" data-dashboard-reset hidden>{{ 'dashboard.reset'|trans }}</button>
        </div>
        <div class="dashboard-mark" aria-hidden="true"><img src="/assets/brand/companyware-mark.svg?v=20260817" alt=""></div>
    </div>
    <section class="dashboard-hidden-manager" data-dashboard-hidden-manager hidden>
        <strong>{{ 'dashboard.available_widgets'|trans }}</strong>
        <div data-dashboard-hidden-list></div>
    </section>
    {% endblock %}

    <div class="dashboard-status-strip">
        <span class="status-dot"></span><strong>{{ 'layout.ready'|trans }}</strong>
        <span>{{ 'dashboard.status_summary'|trans({'%active%': activePluginCount, '%installed%': plugins|length}) }}</span>
        <a href="{{ path('admin_plugins') }}">{{ 'dashboard.manage_system'|trans }} →</a>
    </div>

    {{ plugin_slot('dashboard.content.before', {admin: admin, plugins: plugins}) }}

    {% block dashboard_continue %}
    <section class="dashboard-section dashboard-process-section">
        <div class="dashboard-section-head"><div><h2>{{ 'dashboard.continue'|trans }}</h2><p>{{ 'dashboard.continue_hint'|trans }}</p></div></div>
        <div class="dashboard-flow" data-dashboard-zone="continue">
            {% if continue_items|trim is not empty %}{{ continue_items|raw }}{% else %}<div class="dashboard-placeholder">{{ 'dashboard.continue_empty'|trans }}</div>{% endif %}
        </div>
    </section>
    {% endblock %}

    {% block dashboard_quick_actions %}
    <section class="dashboard-section">
        <div class="dashboard-section-head"><h2>{{ 'dashboard.quick_actions'|trans }}</h2></div>
        <div class="quick-actions">
            {{ plugin_slot('dashboard.quick_actions', {admin: admin, plugins: plugins}) }}
            <a class="quick-action quick-action-system" href="{{ path('admin_plugins') }}"><span class="nav-icon">◇</span><span>{{ 'nav.plugins'|trans }}</span><b>→</b></a>
            <a class="quick-action quick-action-system" href="{{ path('admin_settings') }}"><span class="nav-icon">⚙</span><span>{{ 'nav.settings'|trans }}</span><b>→</b></a>
        </div>
    </section>
    {% endblock %}

    {% block dashboard_widgets %}
    <section class="dashboard-section">
        <div class="dashboard-section-head"><h2>{{ 'dashboard.overview'|trans }}</h2><p>{{ 'dashboard.overview_hint'|trans }}</p></div>
        <div class="dashboard-grid" data-dashboard-zone="widgets">
            {{ plugin_slot('dashboard.widgets', {admin: admin, plugins: plugins}) }}
        </div>
    </section>
    {% endblock %}

    {% block dashboard_activity %}
    <section class="dashboard-section">
        <div class="dashboard-section-head"><div><h2>{{ 'dashboard.activity'|trans }}</h2><p>{{ 'dashboard.activity_hint'|trans }}</p></div></div>
        <div class="dashboard-activity" data-dashboard-zone="activity">
            {% if activity_items|trim is not empty %}{{ activity_items|raw }}{% else %}<div class="dashboard-placeholder">{{ 'dashboard.activity_empty'|trans }}</div>{% endif %}
        </div>
    </section>
    {% endblock %}

    {{ plugin_slot('dashboard.content.after', {admin: admin, plugins: plugins}) }}
</div>
{% endblock %}
