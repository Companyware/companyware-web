{% extends 'admin/layout.html.twig' %}
{% block content %}
<div class="page-head"><div><span class="eyebrow blue">ERWEITERUNGEN</span><h1>Pluginmanager</h1><p>Erweitere die Administration mit unabhängigen Modulen.</p></div></div>
{% if message %}<div class="alert success">{{ message }}</div>{% endif %}{% if error %}<div class="alert error">{{ error }}</div>{% endif %}
<section class="panel plugin-upload"><div><h2>Plugin installieren</h2><p>Geprüftes Pluginpaket als ZIP-Datei, maximal 20 MB.</p></div><form method="post" enctype="multipart/form-data"><input type="hidden" name="_token" value="{{ token }}"><input type="hidden" name="action" value="install"><input type="file" name="plugin_package" accept=".zip,application/zip" required><button class="primary">ZIP installieren</button></form></section>
<div class="stat-row"><div><span>Installiert</span><strong>{{ plugins|length }}</strong></div><div><span>Aktiv</span><strong>{{ plugins|filter(p => p.active)|length }}</strong></div><div><span>Updates</span><strong>0</strong></div></div>
<section class="panel"><div class="panel-head"><div><h2>Installierte Plugins</h2><p>Aktiviere, deaktiviere und verwalte deine Erweiterungen.</p></div><input class="search" type="search" placeholder="Plugins durchsuchen …"></div><div class="plugin-list">
{% for plugin in plugins %}<article class="plugin-item"><div class="plugin-symbol">{{ plugin.label|slice(0,1)|upper }}</div><div class="plugin-info"><h3>{{ plugin.label }} {% if plugin.core %}<span class="badge">CORE</span>{% endif %}</h3><p>{{ plugin.description }}</p><small>Version {{ plugin.version }}</small></div><span class="state {{ plugin.active ? 'on' : '' }}">{{ plugin.active ? 'Aktiv' : 'Inaktiv' }}</span>{% if not plugin.core %}<div class="plugin-actions"><form method="post"><input type="hidden" name="_token" value="{{ token }}"><input type="hidden" name="action" value="toggle"><input type="hidden" name="plugin" value="{{ plugin.name }}"><button class="secondary">{{ plugin.active ? 'Deaktivieren' : 'Aktivieren' }}</button></form><form method="post" onsubmit="return confirm('Plugin inklusive seiner Daten vollständig deinstallieren?')"><input type="hidden" name="_token" value="{{ token }}"><input type="hidden" name="action" value="uninstall"><input type="hidden" name="plugin" value="{{ plugin.name }}"><button class="danger">Deinstallieren</button></form></div>{% endif %}</article>{% endfor %}
</div></section>{% endblock %}
