{% extends 'admin/layout.html.twig' %}
{% block content %}
<div class="page-head"><div><span class="eyebrow blue">{{ 'plugins.eyebrow'|trans }}</span><h1>{{ 'plugins.title'|trans }}</h1><p>{{ 'plugins.intro'|trans }}</p></div></div>
{% if message %}<div class="alert success">{{ message }}</div>{% endif %}{% if error %}<div class="alert error">{{ error }}</div>{% endif %}
<section class="panel plugin-upload"><div><h2>{{ 'plugins.install_title'|trans }}</h2><p>{{ 'plugins.install_hint'|trans }}</p></div><form method="post" enctype="multipart/form-data"><input type="hidden" name="_token" value="{{ token }}"><input type="hidden" name="action" value="install"><input type="file" name="plugin_package" accept=".zip,application/zip" required><button class="primary">{{ 'plugins.install'|trans }}</button></form></section>
<div class="stat-row"><div><span>{{ 'plugins.installed'|trans }}</span><strong>{{ plugins|length }}</strong></div><div><span>{{ 'plugins.active_count'|trans }}</span><strong>{{ plugins|filter(p => p.active)|length }}</strong></div><div><span>{{ 'plugins.updates'|trans }}</span><strong>0</strong></div></div>
<section class="panel"><div class="panel-head"><div><h2>{{ 'plugins.list_title'|trans }}</h2><p>{{ 'plugins.list_hint'|trans }}</p></div><input class="search" type="search" placeholder="{{ 'plugins.search'|trans }}"></div><div class="plugin-list">
{% for plugin in plugins %}<article class="plugin-item"><div class="plugin-symbol">{{ plugin.label|trans|slice(0,1)|upper }}</div><div class="plugin-info"><h3>{{ plugin.label|trans }} {% if plugin.core %}<span class="badge">CORE</span>{% endif %}</h3><p>{{ plugin.description|trans }}</p><small>{{ 'plugins.version'|trans }} {{ plugin.version }}</small></div><span class="state {{ plugin.active ? 'on' : '' }}">{{ (plugin.active ? 'plugins.active' : 'plugins.inactive')|trans }}</span>{% if not plugin.core %}<div class="plugin-actions"><form method="post"><input type="hidden" name="_token" value="{{ token }}"><input type="hidden" name="action" value="toggle"><input type="hidden" name="plugin" value="{{ plugin.name }}"><button class="secondary">{{ (plugin.active ? 'plugins.deactivate' : 'plugins.activate')|trans }}</button></form><form method="post" onsubmit="return confirm('{{ 'plugins.uninstall_confirm'|trans|e('js') }}')"><input type="hidden" name="_token" value="{{ token }}"><input type="hidden" name="action" value="uninstall"><input type="hidden" name="plugin" value="{{ plugin.name }}"><button class="danger">{{ 'plugins.uninstall'|trans }}</button></form></div>{% endif %}</article>{% endfor %}
</div></section>{% endblock %}
