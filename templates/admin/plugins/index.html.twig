{% extends 'admin/layout.html.twig' %}{% block content %}<div class="page-head"><div><span class="eyebrow blue">ERWEITERUNGEN</span><h1>Pluginmanager</h1><p>Erweitere die Administration mit unabhängigen Modulen.</p></div><button class="primary" disabled>Plugin hinzufügen</button></div><div class="stat-row"><div><span>Installiert</span><strong>{{ plugins|length }}</strong></div><div><span>Aktiv</span><strong>{{ plugins|filter(p => p.active)|length }}</strong></div><div><span>Updates</span><strong>0</strong></div></div><section class="panel"><div class="panel-head"><div><h2>Installierte Plugins</h2><p>Aktiviere, deaktiviere und konfiguriere deine Erweiterungen.</p></div><input class="search" type="search" placeholder="Plugins durchsuchen …"></div><div class="plugin-list">{% for plugin in plugins %}<article class="plugin-item"><div class="plugin-symbol">{{ plugin.label|slice(0,1)|upper }}</div><div class="plugin-info"><h3>{{ plugin.label }} {% if plugin.core %}<span class="badge">CORE</span>{% endif %}</h3><p>{{ plugin.description }}</p><small>Version {{ plugin.version }}</small></div><span class="state {{ plugin.active ? 'on' : '' }}">{{ plugin.active ? 'Aktiv' : 'Inaktiv' }}</span>{% if not plugin.core %}<form method="post"><input type="hidden" name="_token" value="{{ token }}"><input type="hidden" name="plugin" value="{{ plugin.name }}"><button class="secondary">{{ plugin.active ? 'Deaktivieren' : 'Aktivieren' }}</button></form>{% endif %}</article>{% endfor %}</div></section>{% endblock %}
