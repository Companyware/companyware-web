{% extends 'base.html.twig' %}

{% block title %}{{ title|trans }} · Companyware{% endblock %}
{% block body_class %}admin-body{% endblock %}

{% block body %}
{% block sidebar %}
<aside class="sidebar">
    <a class="sidebar-brand brand-lockup" href="{{ path('admin_plugins') }}">
        <img src="/assets/brand/companyware-mark.svg?v=20260817" alt="">
        <span><strong>Companyware</strong><small>{{ 'layout.tagline'|trans }}</small></span>
    </a>
    {% set current_route = app.request.attributes.get('_route') %}
    {% set navigation = admin_navigation() %}
    <nav class="sidebar-nav">
        <div class="nav-primary">
            <details class="nav-group" data-nav-group="work" open>
                <summary><span>{{ 'nav.section.workspaces'|trans }}</span><span class="nav-chevron">⌄</span></summary>
                <div class="nav-group-items">
                    {% for item in navigation|filter(item => item.group == 'work') %}
                        <a class="{{ current_route == item.route ? 'active' : '' }}" href="{{ path(item.route) }}">
                            <span class="nav-icon">{{ item.icon }}</span>{{ item.label|trans }}
                        </a>
                    {% endfor %}
                    {{ plugin_slot('admin.navigation.after') }}
                </div>
            </details>
        </div>
        <div class="nav-secondary">
            {% for group, label in {'management': 'nav.section.management', 'account': 'nav.section.account'} %}
                {% set items = navigation|filter(item => item.group == group) %}
                {% set active_group = items|filter(item => item.route == current_route)|length > 0 %}
                <details class="nav-group" data-nav-group="{{ group }}" {{ active_group ? 'open' : '' }}>
                    <summary><span>{{ label|trans }}</span><span class="nav-chevron">⌄</span></summary>
                    <div class="nav-group-items">
                        {% for item in items %}
                            <a class="{{ current_route == item.route ? 'active' : '' }}" href="{{ path(item.route) }}">
                                <span class="nav-icon">{{ item.icon }}</span>{{ item.label|trans }}
                            </a>
                        {% endfor %}
                    </div>
                </details>
            {% endfor %}
        </div>
    </nav>
    <div class="sidebar-user">
        <div class="avatar">{{ admin.display_name|slice(0,2)|upper }}</div>
        <div><strong>{{ admin.display_name }}</strong><small>{{ 'layout.administrator'|trans }}</small></div>
        <form method="post" action="{{ path('app_logout') }}">
            <input type="hidden" name="_token" value="{{ token }}">
            <button title="{{ 'layout.logout'|trans }}">↗</button>
        </form>
    </div>
</aside>
{% endblock %}

<div class="admin-shell">
    <header class="topbar">
        {% block topbar %}
        <button class="mobile-menu" data-admin-menu>☰</button>
        <div class="breadcrumb"><strong>Companyware</strong><span>›</span>{{ title|trans }}</div>
        <div class="top-actions"><span class="status-dot"></span><span>{{ 'layout.ready'|trans }}</span><a href="{{ path('admin_profile') }}" class="mini-avatar">{{ admin.display_name|slice(0,2)|upper }}</a></div>
        {% endblock %}
    </header>
    <main class="admin-content">
        {{ plugin_slot('admin.content.before', {route: app.request.attributes.get('_route')}) }}
        {% block content %}{% endblock %}
        {{ plugin_slot('admin.content.after', {route: app.request.attributes.get('_route')}) }}
    </main>
</div>
{% endblock %}
