{% extends 'base.html.twig' %}{% block title %}{{ title }} · Administration{% endblock %}{% block body_class %}admin-body{% endblock %}{% block body %}{% block sidebar %}<aside class="sidebar"><a class="sidebar-brand" href="{{ path('admin_plugins') }}"><span class="logo">A</span><span><strong>Administration</strong><small>Framework 1.0</small></span></a><nav>{% set section = null %}{% for item in admin_navigation() %}{% if item.section != section %}<span class="nav-caption">{{ item.section }}</span>{% set section = item.section %}{% endif %}<a class="{{ app.request.attributes.get('_route') == item.route ? 'active' : '' }}" href="{{ path(item.route) }}"><span class="nav-icon">{{ item.icon }}</span>{{ item.label }}</a>{% endfor %}{{ plugin_slot('admin.navigation.after') }}</nav><div class="sidebar-user"><div class="avatar">{{ admin.display_name|slice(0,2)|upper }}</div><div><strong>{{ admin.display_name }}</strong><small>Administrator</small></div><form method="post" action="{{ path('app_logout') }}"><input type="hidden" name="_token" value="{{ token }}"><button title="Abmelden">↗</button></form></div></aside>{% endblock %}<div class="admin-shell"><header class="topbar">{% block topbar %}<button class="mobile-menu" onclick="document.body.classList.toggle('menu-open')">☰</button><div class="breadcrumb">Administration <span>/</span> {{ title }}</div><div class="top-actions"><span class="status-dot"></span><span>System bereit</span><a href="{{ path('admin_profile') }}" class="mini-avatar">{{ admin.display_name|slice(0,2)|upper }}</a></div>{% endblock %}</header><main class="admin-content">{{ plugin_slot('admin.content.before', {route: app.request.attributes.get('_route')}) }}{% block content %}{% endblock %}{{ plugin_slot('admin.content.after', {route: app.request.attributes.get('_route')}) }}</main></div>{% endblock %}
