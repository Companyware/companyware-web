{% extends 'admin/layout.html.twig' %}
{% block content %}
<div class="page-head"><div><span class="eyebrow blue">{{ 'security.eyebrow'|trans }}</span><h1>{{ (section == 'users' ? 'security.users_title' : 'security.title')|trans }}</h1><p>{{ (section == 'users' ? 'security.users_intro' : 'security.intro')|trans }}</p></div></div>
{% if message %}<div class="alert success">{{ message }}</div>{% endif %}{% if error %}<div class="alert error">{{ error }}</div>{% endif %}
{% if section == 'users' %}
<section class="panel"><div class="panel-head"><div><h2>{{ 'security.users'|trans }}</h2><p>{{ 'security.users_hint'|trans }}</p></div></div><div class="user-table" role="table"><div class="user-table-head" role="row"><span>{{ 'security.user'|trans }}</span><span>{{ 'security.roles'|trans }}</span><span>{{ 'security.actions'|trans }}</span></div>
{% for user in users %}<div class="user-table-row" role="row"><div class="user-identity"><div class="plugin-symbol">{{ user.display_name|slice(0,1)|upper }}</div><div><strong>{{ user.display_name }}</strong><small>{{ user.username }}{% if user.email %} · {{ user.email }}{% endif %}</small></div></div><div class="user-role-tags">{% for role in roles %}{% if role.id in (assignments[user.id]|default([])) %}<span class="badge">{{ role.role_name }}</span>{% endif %}{% endfor %}</div><div class="user-actions"><a class="icon-action" href="{{ path('admin_users',{edit:user.id}) }}" title="{{ 'security.edit_user'|trans }}" aria-label="{{ 'security.edit_user'|trans }}">✎</a>{% if user.id != admin.id %}<form method="post" onsubmit="return confirm('{{ 'security.delete_user_confirm'|trans|e('js') }}')"><input type="hidden" name="_token" value="{{ token }}"><input type="hidden" name="action" value="delete_user"><input type="hidden" name="admin_id" value="{{ user.id }}"><button class="icon-action danger-icon" title="{{ 'security.delete_user'|trans }}" aria-label="{{ 'security.delete_user'|trans }}">⌫</button></form>{% endif %}</div></div>{% endfor %}</div>
{% if editUser %}<div class="user-editor"><div class="user-editor-head"><div><h3>{{ 'security.edit_user'|trans }}: {{ editUser.display_name }}</h3><p>{{ 'security.assignment_hint'|trans }}</p></div><a class="icon-action" href="{{ path('admin_users') }}" title="{{ 'common.close'|trans }}" aria-label="{{ 'common.close'|trans }}">×</a></div><form method="post" class="user-editor-form"><input type="hidden" name="_token" value="{{ token }}"><input type="hidden" name="action" value="update_user"><input type="hidden" name="admin_id" value="{{ editUser.id }}"><label><span>{{ 'security.username'|trans }}</span><input value="{{ editUser.username }}" disabled></label><label><span>{{ 'security.display_name'|trans }}</span><input name="display_name" value="{{ editUser.display_name }}" required></label><label><span>{{ 'security.email'|trans }}</span><input type="email" name="email" value="{{ editUser.email }}"></label><label><span>{{ 'security.department'|trans }}</span><input name="department" value="{{ editUser.department_key|default('') }}"></label><label><span>{{ 'security.password_optional'|trans }}</span><input type="password" name="password" minlength="10"></label><fieldset><legend>{{ 'security.roles'|trans }}</legend><div class="security-checks">{% for role in roles %}{% if not role.protected or is_granted('core.recovery') %}<label><input type="checkbox" name="roles[]" value="{{ role.id }}" {{ role.id in (assignments[editUser.id]|default([])) ? 'checked' : '' }}> {{ role.role_name }}</label>{% endif %}{% endfor %}</div></fieldset><div class="user-editor-actions"><button class="primary">{{ 'security.save_user'|trans }}</button></div></form></div>{% endif %}
<details class="new-user"><summary>{{ 'security.create_user'|trans }}</summary><form method="post" class="user-editor-form"><input type="hidden" name="_token" value="{{ token }}"><input type="hidden" name="action" value="create_user"><label><span>{{ 'security.username'|trans }}</span><input name="username" required></label><label><span>{{ 'security.display_name'|trans }}</span><input name="display_name" required></label><label><span>{{ 'security.email'|trans }}</span><input type="email" name="email"></label><label><span>{{ 'security.password'|trans }}</span><input type="password" name="password" minlength="10" required></label><fieldset><legend>{{ 'security.roles'|trans }}</legend><div class="security-checks">{% for role in roles %}{% if not role.protected or is_granted('core.recovery') %}<label><input type="checkbox" name="roles[]" value="{{ role.id }}"> {{ role.role_name }}</label>{% endif %}{% endfor %}</div></fieldset><div class="user-editor-actions"><button class="primary">{{ 'security.create_user'|trans }}</button></div></form></details></section>
{% else %}
<section class="panel"><div class="panel-head"><div><h2>{{ 'security.roles'|trans }}</h2><p>{{ 'security.roles_hint'|trans }}</p></div></div>
<div class="new-role"><form method="post" class="security-checks"><input type="hidden" name="_token" value="{{ token }}"><input type="hidden" name="action" value="create_role"><label><span>{{ 'security.new_role'|trans }}</span><input name="role_name" required placeholder="{{ 'security.role_name'|trans }}"></label><button class="secondary">{{ 'security.create_role'|trans }}</button></form></div>
<div class="role-editor-list">{% for role in roles %}{% if role.protected %}<article class="role-protected"><div><strong>{{ role.role_name }}</strong><span class="badge">{{ 'security.protected'|trans }}</span></div><p>{{ 'security.all_permissions'|trans }}</p></article>{% else %}<details class="role-editor" {% if role.id == openRoleId %}open{% endif %}><summary><span><strong>{{ role.role_name }}</strong><small>{{ (rolePrivileges[role.id]|default([]))|length }} {{ 'security.permissions_count'|trans }}</small></span><span class="role-editor-action">{{ 'security.edit_permissions'|trans }}</span></summary><form method="post" class="role-permissions"><input type="hidden" name="_token" value="{{ token }}"><input type="hidden" name="action" value="update_role"><input type="hidden" name="role_id" value="{{ role.id }}">{% set currentGroup = '' %}{% for privilege in privileges %}{% if not privilege.protected %}{% set groupKey = privilege.owner ~ ':' ~ privilege.privilege_group %}{% if groupKey != currentGroup %}{% if currentGroup != '' %}</div></fieldset>{% endif %}<fieldset><legend><strong>{{ privilege.owner == 'core' ? 'Companyware Core' : privilege.owner|title }}</strong><span>{{ ('security.group.' ~ privilege.privilege_group)|trans }}</span></legend><div class="role-permission-options">{% set currentGroup = groupKey %}{% endif %}<label title="{{ privilege.privilege_key }}"><input type="checkbox" name="privileges[]" value="{{ privilege.privilege_key }}" {{ privilege.privilege_key in (rolePrivileges[role.id]|default([])) ? 'checked' : '' }}><span>{{ privilege.label|trans }}</span>{% set scopeOptions = privilege.supported_scopes|default('all')|split(',') %}{% if scopeOptions|length > 1 %}<select name="scopes[{{ privilege.privilege_key }}]" aria-label="{{ 'security.scope'|trans }}">{% for scope in scopeOptions %}<option value="{{ scope }}" {{ (rolePrivilegeScopes[role.id][privilege.privilege_key]|default('all')) == scope ? 'selected' : '' }}>{{ ('security.scope.' ~ scope)|trans }}</option>{% endfor %}</select>{% endif %}</label>{% endif %}{% endfor %}{% if currentGroup != '' %}</div></fieldset>{% endif %}<div class="role-permission-actions"><small>{{ 'security.registry_only'|trans }}</small><button class="primary">{{ 'security.save_rights'|trans }}</button></div></form><form method="post" class="role-delete" onsubmit="return confirm('{{ 'security.delete_role_confirm'|trans|e('js') }}')"><input type="hidden" name="_token" value="{{ token }}"><input type="hidden" name="action" value="delete_role"><input type="hidden" name="role_id" value="{{ role.id }}"><button class="danger">{{ 'security.delete_role'|trans }}</button></form></details>{% endif %}{% endfor %}</div></section>
<section class="panel"><div class="panel-head"><div><h2>{{ 'security.audit'|trans }}</h2><p>{{ 'security.audit_hint'|trans }}</p></div></div><div class="migration-list">{% for entry in auditLog %}<div class="migration-row"><div><strong>{{ entry.action_name|trans }}</strong><small>{{ entry.actor_name|default('System') }}</small></div><span>{{ ('security.audit_target.' ~ entry.target_type)|trans }}</span><span>{{ entry.target_id }}</span><small>{{ entry.created_at }}</small></div>{% else %}<div class="empty-state">{{ 'security.audit_empty'|trans }}</div>{% endfor %}</div></section>
{% endif %}{% endblock %}
