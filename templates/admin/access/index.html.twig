{% extends 'admin/layout.html.twig' %}
{% block content %}
<div class="page-head"><div><span class="eyebrow blue">{{ 'security.eyebrow'|trans }}</span><h1>{{ 'security.title'|trans }}</h1><p>{{ 'security.intro'|trans }}</p></div></div>
{% if message %}<div class="alert success">{{ message }}</div>{% endif %}{% if error %}<div class="alert error">{{ error }}</div>{% endif %}
<section class="panel"><div class="panel-head"><div><h2>{{ 'security.users'|trans }}</h2><p>{{ 'security.users_hint'|trans }}</p><small>{{ 'security.assignment_hint'|trans }}</small></div></div><div class="plugin-list">
{% for user in users %}<article class="plugin-item"><div class="plugin-symbol">{{ user.display_name|slice(0,1)|upper }}</div><div class="plugin-info"><h3>{{ user.display_name }}</h3><p>{{ user.username }}{% if user.email %} · {{ user.email }}{% endif %}</p></div><form method="post" class="security-checks"><input type="hidden" name="_token" value="{{ token }}"><input type="hidden" name="action" value="assign_roles"><input type="hidden" name="admin_id" value="{{ user.id }}">{% for role in roles %}{% if not role.protected or is_granted('core.recovery') %}<label><input type="checkbox" name="roles[]" value="{{ role.id }}" {{ role.id in (assignments[user.id]|default([])) ? 'checked' : '' }}> {{ role.role_name }}</label>{% endif %}{% endfor %}<button class="secondary">{{ 'security.save_assignment'|trans }}</button></form></article>{% endfor %}
<article class="plugin-item"><div class="plugin-info"><h3>{{ 'security.new_user'|trans }}</h3></div><form method="post" class="security-checks"><input type="hidden" name="_token" value="{{ token }}"><input type="hidden" name="action" value="create_user"><input name="username" required placeholder="{{ 'security.username'|trans }}"><input name="display_name" required placeholder="{{ 'security.display_name'|trans }}"><input type="email" name="email" placeholder="{{ 'security.email'|trans }}"><input type="password" name="password" minlength="10" required placeholder="{{ 'security.password'|trans }}">{% for role in roles %}{% if not role.protected or is_granted('core.recovery') %}<label><input type="checkbox" name="roles[]" value="{{ role.id }}"> {{ role.role_name }}</label>{% endif %}{% endfor %}<button class="primary">{{ 'security.create_user'|trans }}</button></form></article>
</div></section>
<section class="panel"><div class="panel-head"><div><h2>{{ 'security.roles'|trans }}</h2><p>{{ 'security.roles_hint'|trans }}</p></div></div>
<form method="post" class="permission-matrix-form"><input type="hidden" name="_token" value="{{ token }}"><input type="hidden" name="action" value="update_role_matrix">{% for role in roles %}{% if not role.protected %}<input type="hidden" name="role_ids[]" value="{{ role.id }}">{% endif %}{% endfor %}
<div class="permission-matrix-scroll"><table class="permission-matrix"><thead><tr><th scope="col">{{ 'security.permission'|trans }}</th>{% for role in roles %}<th scope="col"><span>{{ role.role_name }}</span>{% if role.protected %}<small>{{ 'security.protected'|trans }}</small>{% endif %}</th>{% endfor %}</tr></thead><tbody>
{% set currentGroup = '' %}{% for privilege in privileges %}{% set groupKey = privilege.owner ~ ':' ~ privilege.privilege_group %}{% if groupKey != currentGroup %}<tr class="permission-group"><th colspan="{{ roles|length + 1 }}"><strong>{{ privilege.owner == 'core' ? 'Companyware Core' : privilege.owner|title }}</strong><span>{{ ('security.group.' ~ privilege.privilege_group)|trans }}</span></th></tr>{% set currentGroup = groupKey %}{% endif %}
<tr><th scope="row"><span>{{ privilege.label|trans }}</span><code>{{ privilege.privilege_key }}</code>{% if privilege.protected %}<small class="badge">{{ 'security.protected'|trans }}</small>{% endif %}</th>{% for role in roles %}<td><label class="permission-toggle"><input type="checkbox" {% if not role.protected and not privilege.protected %}name="privileges[{{ role.id }}][]" value="{{ privilege.privilege_key }}"{% else %}disabled{% endif %} {{ role.protected or privilege.privilege_key in (rolePrivileges[role.id]|default([])) ? 'checked' : '' }}><span class="sr-only">{{ role.role_name }} – {{ privilege.label|trans }}</span></label></td>{% endfor %}</tr>{% endfor %}
</tbody></table></div><div class="permission-matrix-actions"><p>{{ 'security.registry_only'|trans }}</p><button class="primary">{{ 'security.save_matrix'|trans }}</button></div></form>
<div class="new-role"><form method="post" class="security-checks"><input type="hidden" name="_token" value="{{ token }}"><input type="hidden" name="action" value="create_role"><label><span>{{ 'security.new_role'|trans }}</span><input name="role_name" required placeholder="{{ 'security.role_name'|trans }}"></label><button class="secondary">{{ 'security.create_role'|trans }}</button></form></div></section>
<section class="panel"><div class="panel-head"><div><h2>{{ 'security.audit'|trans }}</h2><p>{{ 'security.audit_hint'|trans }}</p></div></div><div class="migration-list">{% for entry in auditLog %}<div class="migration-row"><div><strong>{{ entry.action_name }}</strong><small>{{ entry.actor_name|default('System') }}</small></div><span>{{ entry.target_type }}</span><span>{{ entry.target_id }}</span><small>{{ entry.created_at }}</small></div>{% else %}<div class="empty-state">{{ 'security.audit_empty'|trans }}</div>{% endfor %}</div></section>{% endblock %}
