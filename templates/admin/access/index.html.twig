{% extends 'admin/layout.html.twig' %}
{% block content %}
<div class="page-head"><div><span class="eyebrow blue">{{ 'security.eyebrow'|trans }}</span><h1>{{ 'security.title'|trans }}</h1><p>{{ 'security.intro'|trans }}</p></div></div>
{% if message %}<div class="alert success">{{ message }}</div>{% endif %}{% if error %}<div class="alert error">{{ error }}</div>{% endif %}
<section class="panel"><div class="panel-head"><div><h2>{{ 'security.users'|trans }}</h2><p>{{ 'security.users_hint'|trans }}</p></div></div><div class="plugin-list">
{% for user in users %}<article class="plugin-item"><div class="plugin-symbol">{{ user.display_name|slice(0,1)|upper }}</div><div class="plugin-info"><h3>{{ user.display_name }}</h3><p>{{ user.username }}{% if user.email %} · {{ user.email }}{% endif %}</p></div><form method="post" class="security-checks"><input type="hidden" name="_token" value="{{ token }}"><input type="hidden" name="action" value="assign_roles"><input type="hidden" name="admin_id" value="{{ user.id }}">{% for role in roles %}{% if not role.protected or is_granted('core.recovery') %}<label><input type="checkbox" name="roles[]" value="{{ role.id }}" {{ role.id in (assignments[user.id]|default([])) ? 'checked' : '' }}> {{ role.role_name }}</label>{% endif %}{% endfor %}<button class="secondary">{{ 'security.save_assignment'|trans }}</button></form></article>{% endfor %}
<article class="plugin-item"><div class="plugin-info"><h3>{{ 'security.new_user'|trans }}</h3></div><form method="post" class="security-checks"><input type="hidden" name="_token" value="{{ token }}"><input type="hidden" name="action" value="create_user"><input name="username" required placeholder="{{ 'security.username'|trans }}"><input name="display_name" required placeholder="{{ 'security.display_name'|trans }}"><input type="email" name="email" placeholder="{{ 'security.email'|trans }}"><input type="password" name="password" minlength="10" required placeholder="{{ 'security.password'|trans }}">{% for role in roles %}{% if not role.protected or is_granted('core.recovery') %}<label><input type="checkbox" name="roles[]" value="{{ role.id }}"> {{ role.role_name }}</label>{% endif %}{% endfor %}<button class="primary">{{ 'security.create_user'|trans }}</button></form></article>
</div></section>
<section class="panel"><div class="panel-head"><div><h2>{{ 'security.roles'|trans }}</h2><p>{{ 'security.roles_hint'|trans }}</p></div></div><div class="plugin-list">
{% for role in roles %}<article class="plugin-item"><div class="plugin-info"><h3>{{ role.role_name }}{% if role.protected %} <span class="badge">{{ 'security.protected'|trans }}</span>{% endif %}</h3></div>{% if not role.protected %}<form method="post" class="security-checks"><input type="hidden" name="_token" value="{{ token }}"><input type="hidden" name="action" value="update_role"><input type="hidden" name="role_id" value="{{ role.id }}">{% for privilege in privileges %}{% if not privilege.protected %}<label><input type="checkbox" name="privileges[]" value="{{ privilege.privilege_key }}" {{ privilege.privilege_key in (rolePrivileges[role.id]|default([])) ? 'checked' : '' }}> {{ privilege.label|trans }}</label>{% endif %}{% endfor %}<button class="secondary">{{ 'security.save_role'|trans }}</button></form>{% endif %}</article>{% endfor %}
<article class="plugin-item"><div class="plugin-info"><h3>{{ 'security.new_role'|trans }}</h3></div><form method="post" class="security-checks"><input type="hidden" name="_token" value="{{ token }}"><input type="hidden" name="action" value="create_role"><input name="role_name" required placeholder="{{ 'security.role_name'|trans }}">{% for privilege in privileges %}{% if not privilege.protected %}<label><input type="checkbox" name="privileges[]" value="{{ privilege.privilege_key }}"> {{ privilege.label|trans }}</label>{% endif %}{% endfor %}<button class="primary">{{ 'security.create_role'|trans }}</button></form></article>
</div></section>
<section class="panel"><div class="panel-head"><div><h2>{{ 'security.audit'|trans }}</h2><p>{{ 'security.audit_hint'|trans }}</p></div></div><div class="migration-list">{% for entry in auditLog %}<div class="migration-row"><div><strong>{{ entry.action_name }}</strong><small>{{ entry.actor_name|default('System') }}</small></div><span>{{ entry.target_type }}</span><span>{{ entry.target_id }}</span><small>{{ entry.created_at }}</small></div>{% else %}<div class="empty-state">{{ 'security.audit_empty'|trans }}</div>{% endfor %}</div></section>{% endblock %}
