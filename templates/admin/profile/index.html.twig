{% extends 'admin/layout.html.twig' %}{% block content %}<div class="page-head"><div><span class="eyebrow blue">{{ 'profile.eyebrow'|trans }}</span><h1>{{ 'profile.title'|trans }}</h1><p>{{ 'profile.intro'|trans }}</p></div></div>{% if saved %}<div class="alert success">{{ 'profile.saved'|trans }}</div>{% endif %}{% if verificationResult == 'sent' %}<div class="alert success">{{ 'profile.email_verification_sent'|trans }}</div>{% elseif verificationResult is same as(true) %}<div class="alert success">{{ 'profile.email_verified'|trans }}</div>{% elseif verificationResult is same as(false) %}<div class="alert error">{{ 'profile.email_verification_failed'|trans }}</div>{% endif %}<section class="panel form-panel"><div class="profile-header"><div class="avatar large">{{ admin.display_name|slice(0,2)|upper }}</div><div><h2>{{ admin.display_name }}</h2><p>{{ 'layout.administrator'|trans }}</p></div></div>{{ plugin_slot('admin.profile.form.before', {admin: admin}) }}<form method="post" class="admin-form"><input type="hidden" name="_token" value="{{ token }}"><label>{{ 'profile.display_name'|trans }}<input name="display_name" value="{{ admin.display_name }}" required></label><label>{{ 'profile.username'|trans }}<input value="{{ admin.username }}" disabled></label><label>{{ 'profile.email'|trans }}<input type="email" name="email" value="{{ admin.email|default('') }}" placeholder="name@example.com"></label><div class="form-actions"><button class="primary">{{ 'profile.save'|trans }}</button></div></form><form method="post" class="admin-form"><input type="hidden" name="_token" value="{{ token }}"><input type="hidden" name="action" value="verify_recovery_email"><div class="form-actions"><button class="secondary">{{ 'profile.email_verify'|trans }}</button></div></form>{{ plugin_slot('admin.profile.form.after', {admin: admin}) }}</section><section class="panel form-panel profile-recovery-panel"><div class="profile-header"><div><h2>{{ 'profile.recovery_title'|trans }}</h2><p>{{ 'profile.recovery_hint'|trans }}</p></div></div>{% if recoveryKey %}<div class="alert success"><strong>{{ 'profile.recovery_once'|trans }}</strong><code class="recovery-key">{{ recoveryKey.key }}</code><small>{{ 'profile.recovery_expires'|trans({'%expires%': recoveryKey.expires_at|date('d.m.Y H:i')}) }}</small></div>{% endif %}<form method="post" class="admin-form"><input type="hidden" name="_token" value="{{ token }}"><input type="hidden" name="action" value="issue_recovery_key"><div class="form-actions"><button class="secondary">{{ 'profile.recovery_issue'|trans }}</button></div></form></section><section class="panel access-summary"><div class="panel-head"><div><h2>{{ 'profile.access_title'|trans }}</h2><p>{{ 'profile.access_hint'|trans }}</p></div>{% if is_granted('core.security.manage') %}<a class="secondary" href="{{ path('admin_access') }}">{{ 'profile.manage_access'|trans }}</a>{% endif %}</div><div class="access-summary-content"><h3>{{ 'profile.roles'|trans }}</h3><div class="access-tags">{% for role in accessSummary.roles %}<span class="badge">{{ role.role_name }}</span>{% else %}<span>{{ 'profile.no_roles'|trans }}</span>{% endfor %}</div><h3>{{ 'profile.permissions'|trans }}</h3>{% if accessSummary.systemAdministrator %}<p class="access-note">{{ 'profile.system_access'|trans }}</p>{% endif %}<div class="access-permission-table-wrap"><table class="access-permission-table"><thead><tr><th>{{ 'profile.permission_package'|trans }}</th><th>{{ 'profile.permission_area'|trans }}</th><th>{{ 'profile.permission_name'|trans }}</th></tr></thead><tbody>{% for privilege in accessSummary.privileges %}<tr><td>{{ privilege.owner == 'core' ? 'Companyware Core' : privilege.owner|title }}</td><td>{{ ('security.group.' ~ privilege.privilege_group)|trans }}</td><td><strong>{{ privilege.label|trans }}</strong></td></tr>{% else %}<tr><td colspan="3">{{ 'profile.no_permissions'|trans }}</td></tr>{% endfor %}</tbody></table></div></div></section>{% endblock %}
