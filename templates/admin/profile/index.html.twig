{% extends 'admin/layout.html.twig' %}{% block content %}<div class="page-head"><div><span class="eyebrow blue">{{ 'profile.eyebrow'|trans }}</span><h1>{{ 'profile.title'|trans }}</h1><p>{{ 'profile.intro'|trans }}</p></div></div>{% if saved %}<div class="alert success">{{ 'profile.saved'|trans }}</div>{% endif %}<section class="panel form-panel"><div class="profile-header"><div class="avatar large">{{ admin.display_name|slice(0,2)|upper }}</div><div><h2>{{ admin.display_name }}</h2><p>{{ 'layout.administrator'|trans }}</p></div></div>{{ plugin_slot('admin.profile.form.before', {admin: admin}) }}<form method="post" class="admin-form"><input type="hidden" name="_token" value="{{ token }}"><label>{{ 'profile.display_name'|trans }}<input name="display_name" value="{{ admin.display_name }}" required></label><label>{{ 'profile.username'|trans }}<input value="{{ admin.username }}" disabled></label><label>{{ 'profile.email'|trans }}<input type="email" name="email" value="{{ admin.email|default('') }}" placeholder="name@example.com"></label><div class="form-actions"><button class="primary">{{ 'profile.save'|trans }}</button></div></form>{{ plugin_slot('admin.profile.form.after', {admin: admin}) }}</section>{% endblock %}
