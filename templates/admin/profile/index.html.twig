{% extends 'admin/layout.html.twig' %}{% block content %}<div class="page-head"><div><span class="eyebrow blue">KONTO</span><h1>Benutzerprofil</h1><p>Verwalte deine persönlichen Angaben.</p></div></div>{% if saved %}<div class="alert success">Dein Profil wurde gespeichert.</div>{% endif %}<section class="panel form-panel"><div class="profile-header"><div class="avatar large">{{ admin.display_name|slice(0,2)|upper }}</div><div><h2>{{ admin.display_name }}</h2><p>Administrator</p></div></div>{{ plugin_slot('admin.profile.form.before', {admin: admin}) }}<form method="post" class="admin-form"><input type="hidden" name="_token" value="{{ token }}"><label>Anzeigename<input name="display_name" value="{{ admin.display_name }}" required></label><label>Benutzername<input value="{{ admin.username }}" disabled></label><label>E-Mail-Adresse<input type="email" name="email" value="{{ admin.email|default('') }}" placeholder="name@firma.de"></label><div class="form-actions"><button class="primary">Änderungen speichern</button></div></form>{{ plugin_slot('admin.profile.form.after', {admin: admin}) }}</section>{% endblock %}
