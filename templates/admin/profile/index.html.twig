{% extends 'admin/layout.html.twig' %}{% block content %}<div class="page-head"><div><span class="eyebrow blue">{{ 'profile.eyebrow'|trans }}</span><h1>{{ 'profile.title'|trans }}</h1><p>{{ 'profile.intro'|trans }}</p></div></div>{% if saved %}<div class="alert success">{{ 'profile.saved'|trans }}</div>{% endif %}<section class="panel form-panel"><div class="profile-header"><div class="avatar large">{{ admin.display_name|slice(0,2)|upper }}</div><div><h2>{{ admin.display_name }}</h2><p>{{ 'layout.administrator'|trans }}</p></div></div>{{ plugin_slot('admin.profile.form.before', {admin: admin}) }}<form method="post" class="admin-form"><input type="hidden" name="_token" value="{{ token }}"><label>{{ 'profile.display_name'|trans }}<input name="display_name" value="{{ admin.display_name }}" required></label><label>{{ 'profile.username'|trans }}<input value="{{ admin.username }}" disabled></label><label>{{ 'profile.email'|trans }}<input type="email" name="email" value="{{ admin.email|default('') }}" placeholder="name@example.com"></label><div class="form-actions"><button class="primary">{{ 'profile.save'|trans }}</button></div></form>{{ plugin_slot('admin.profile.form.after', {admin: admin}) }}</section><section class="panel access-summary"><div class="panel-head"><div><h2>{{ 'profile.access_title'|trans }}</h2><p>{{ 'profile.access_hint'|trans }}</p></div>{% if is_granted('core.security.manage') %}<a class="secondary" href="{{ path('admin_access') }}">{{ 'profile.manage_access'|trans }}</a>{% endif %}</div><div class="access-summary-content"><h3>{{ 'profile.roles'|trans }}</h3><div class="access-tags">{% for role in accessSummary.roles %}<span class="badge">{{ role.role_name }}</span>{% else %}<span>{{ 'profile.no_roles'|trans }}</span>{% endfor %}</div><h3>{{ 'profile.permissions'|trans }}</h3>{% if accessSummary.systemAdministrator %}<p class="access-note">{{ 'profile.system_access'|trans }}</p>{% endif %}<div class="access-permission-list">{% for privilege in accessSummary.privileges %}<span><strong>{{ privilege.label|trans }}</strong></span>{% else %}<span>{{ 'profile.no_permissions'|trans }}</span>{% endfor %}</div></div></section>{% endblock %}
